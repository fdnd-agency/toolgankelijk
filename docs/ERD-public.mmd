erDiagram
    WEBSITE {
        int id PK
        string slug
        string title
        string homepage
        string preview_file_id FK
    }

    URL {
        int id PK
        int website_id FK
        string slug
        string name
        string url
    }

    CHECK {
        int id PK
        int url_id FK
        datetime date_created
        datetime date_updated
    }

    TEST {
        int id PK
        int url_id FK
        string test_id
        string category
        string description
        string help_url
        string tags
    }

    TEST_NODE {
        int id PK
        int test_id FK
        string target
        string failure_summary
    }

    PRINCIPLE {
        int id PK
        string index
        string slug
        string title
        string description
    }

    GUIDELINE {
        int id PK
        string index
        string slug
        string title
        string explanation
    }

    SUCCESS_CRITERIA {
        int id PK
        string index
        string title
        string level
        string criteria
        string easy_criteria
    }

    CHECKLIST_ITEM {
        int id PK
        int principle_id FK
        string question
        string check
        string tip
        string explanation
    }

    LEVEL {
        int id PK
        string level
        string slug
    }

    WEBSITE ||--o{ URL : has
    URL ||--o{ CHECK : has
    URL ||--o{ TEST : has
    TEST ||--o{ TEST_NODE : has
    PRINCIPLE ||--o{ CHECKLIST_ITEM : contains
    PRINCIPLE ||--o{ GUIDELINE : groups
    GUIDELINE ||--o{ SUCCESS_CRITERIA : contains
    CHECKLIST_ITEM ||--o{ SUCCESS_CRITERIA : maps_to
    CHECK ||--o{ SUCCESS_CRITERIA : verifies
    LEVEL ||--o{ SUCCESS_CRITERIA : classifies
